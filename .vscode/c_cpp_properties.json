{
  "configurations": [
    {
      "name": "Arduino AVR (Uno)",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.7/cores/arduino",
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.7/variants/standard",
        "${env:HOME}/Library/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/avr/include",
        "${env:HOME}/Library/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/lib/gcc/avr/7.3.0/include",
        "${env:HOME}/Library/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/lib/gcc/avr/7.3.0/include-fixed"
      ],
      "defines": [
        "ARDUINO=10607",
        "ARDUINO_AVR_UNO",
        "ARDUINO_ARCH_AVR",
        "F_CPU=16000000L"
      ],
      "compilerPath": "${env:HOME}/Library/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin/avr-g++",
      "compilerArgs": ["-mmcu=atmega328p"],
      "cStandard": "c11",
      "cppStandard": "c++11",
      "intelliSenseMode": "gcc-x64"
    }
  ],
  "version": 4
}
